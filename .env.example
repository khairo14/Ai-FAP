# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/[project-id]/settings/api
SUPABASE_URL=https://[your-project-id].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_PROJECT_ID=your_project_id
SUPABASE_PROJECT_NAME=your_project_name

# App Configuration
APP_NAME=AI-FAP
APP_VERSION=1.0.0
ENVIRONMENT=development

# API Configuration (for future use)
# GOOGLE_CLOUD_VISION_API_KEY=your_api_key_here
# ONESIGNAL_APP_ID=your_onesignal_id

# RevenueCat Configuration
# All RC keys are PUBLIC (not secrets) — safe to be in client code.
# Get from: RevenueCat Dashboard → Project → Apps

# iOS / Android SDK keys (purchases_flutter)
# Get from: RC Dashboard → [iOS App] / [Android App] → API Keys
REVENUECAT_IOS_KEY=appl_your_ios_sdk_key_here
REVENUECAT_ANDROID_KEY=goog_your_android_sdk_key_here

# Web Billing public key (rcb_...)
# Get from: RC Dashboard → FundVance AI (Web Billing) → Public API Key
REVENUECAT_WEB_KEY=rcb_your_web_public_key_here

# Web Billing sandbox key (rcb_sb_...) — used in debug/test builds only
# Get from: RC Dashboard → FundVance AI (Web Billing) → Sandbox API Key
REVENUECAT_WEB_SANDBOX_KEY=rcb_sb_your_web_sandbox_key_here

# RC Web Billing configuration identifier
# Get from: RC Dashboard → FundVance AI (Web Billing) → REST API Identifier
REVENUECAT_WEB_APP_ID=app_your_web_app_id_here

# Entitlement & offering identifiers (must match RC Dashboard exactly)
REVENUECAT_ENTITLEMENT_ID=FundVance Ai Pro
REVENUECAT_OFFERING_ID=default
