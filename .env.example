# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/[project-id]/settings/api
SUPABASE_URL=https://[your-project-id].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_PROJECT_ID=your_project_id
SUPABASE_PROJECT_NAME=your_project_name

# App Configuration
APP_NAME=AI-FAP
APP_VERSION=1.0.0
ENVIRONMENT=development

# API Configuration (for future use)
# GOOGLE_CLOUD_VISION_API_KEY=your_api_key_here
# ONESIGNAL_APP_ID=your_onesignal_id

# Stripe Configuration (web/desktop payments)
# STRIPE_SECRET_KEY is set via: supabase secrets set STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET is set via: supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_MONTHLY_PRICE_ID=price_your_monthly_price_id
STRIPE_ANNUAL_PRICE_ID=price_your_annual_price_id
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# RevenueCat Configuration (iOS/Android in-app purchases)
# SDK key is PUBLIC - safe to be in client code (not a secret)
# Get from: RevenueCat Dashboard → Project → API Keys → SDK API keys → Test Store
REVENUECAT_TEST_KEY=test_your_revenuecat_test_key_here
